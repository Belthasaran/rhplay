{
  "name": "rhtools",
  "version": "0.1.31beta",
  "description": "RHTools - ROM HackPlay Tools Application",
  "author": "RHTools Team <143627208+Belthasaran@users.noreply.github.com>",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "cd native-modules/serialport-nonblock && npm install && cd ../.. && patch-package && electron-builder install-app-deps",
    "rebuild:native": "cd native-modules/serialport-nonblock && npm run install && cd ../.. && electron-rebuild",
    "electron:start": "cross-env ELECTRON_START_URL=http://localhost:5173 electron electron/main.js --xdg-portal-required-version=4",
    "electron:start-smart": "cd electron && ./smart-start.sh",
    "renderer:dev": "npm --prefix electron/renderer run dev",
    "build:twitch-config": "node scripts/build-twitch-config.js",
    "renderer:build": "npm run build:twitch-config && npm --prefix electron/renderer run build && npm run fix-asset-paths",
    "fix-asset-paths": "node scripts/fix-asset-paths.js",
    "app:dev": "run-p renderer:dev electron:start",
    "app:dev-smart": "cd electron && ./smart-start.sh",
    "app:build": "npm run renderer:build",
    "build:win": "npm run renderer:build && electron-builder --win portable",
    "build:win-all": "npm run renderer:build && electron-builder --win nsis,portable",
    "build:linux": "npm run renderer:build && electron-builder --linux AppImage",
    "build:mac": "npm run renderer:build && electron-builder --mac",
    "build:installer:win": "npm run renderer:build && electron-builder --win nsis",
    "build:installer:linux": "npm run renderer:build && electron-builder --linux deb",
    "build:installer:mac": "npm run renderer:build && electron-builder --mac dmg",
    "launcher:renderer:dev": "npm --prefix rhtools-launcher run renderer:dev",
    "launcher:renderer:build": "npm --prefix rhtools-launcher run renderer:build",
    "launcher:dev": "cross-env ELECTRON_RUN_AS_NODE= ELECTRON_START_URL=http://localhost:5174 node_modules/.bin/electron rhtools-launcher/main.js --xdg-portal-required-version=4",
    "launcher:dev-smart": "bash rhtools-launcher/smart-start.sh",
    "launcher:install-app-deps": "node scripts/launcher-install-app-deps.cjs",
    "launcher:prune-for-pack": "npm prune --prefix rhtools-launcher --omit=dev",
    "build:launcher:win": "npm install --prefix rhtools-launcher && npm run launcher:renderer:build && npm run launcher:install-app-deps && npm run launcher:prune-for-pack && electron-builder --win portable --config electron-builder.cjs --projectDir rhtools-launcher",
    "build:launcher:linux": "npm install --prefix rhtools-launcher && npm run launcher:renderer:build && npm run launcher:install-app-deps && npm run launcher:prune-for-pack && electron-builder --linux AppImage --config electron-builder.cjs --projectDir rhtools-launcher",
    "loaddata": "node loaddata.js",
    "attachblobs": "node attachblobs.js",
    "fetchpatches": "node fetchpatches.js",
    "fetchpatches:mode1": "node fetchpatches.js mode1",
    "fetchpatches:mode2": "node fetchpatches.js mode2",
    "fetchpatches:mode3": "node fetchpatches.js mode3",
    "fetchpatches:addsizes": "node fetchpatches.js addsizes",
    "migrate:ipfsgateways": "node migrate_ipfsgateways.js",
    "update:ipfsgateways": "node update_ipfs_gateways.js",
    "test:mode2": "cd tests && node test_mode2.js",
    "test:mode3": "node tests/test_mode3.js",
    "test:setup": "node tests/setup_test_env.js",
    "test:create-signers": "node tests/create_test_signers.js",
    "test:server": "node tests/test_server.js",
    "test:e2e": "node tests/test_e2e_apig.js",
    "mdserver:start": "node mdserver/server.js",
    "mdserver:create-client": "node mdserver/create_client.js",
    "mdserver:setup": "node mdserver/setup.js",
    "mdserver:create-signer": "node mdserver/create_signer.js",
    "mdserver:sign-metadata": "node mdserver/sign_metadata.js",
    "mdserver:migrate-signatures": "node mdserver/migrate_signatures.js",
    "mdserver:cleanup-signatures": "node mdserver/cleanup_signatures.js",
    "client:migrate-apiserver": "node electron/migrate_apiservers.js",
    "client:add-apiserver": "node electron/manage_apiserver.js add",
    "client:list-apiservers": "node electron/manage_apiserver.js list",
    "client:test-apiserver": "node electron/manage_apiserver.js test",
    "updategames": "node updategames.js",
    "updategames:all": "node updategames.js --all-patches",
    "updategames:test": "node updategames.js --dry-run --limit=5",
    "updategames:resume": "node updategames.js --resume",
    "test:blob-compat": "node tests/test_blob_compatibility.js",
    "test:patch-resolver": "node tests/test_patch_resolver.js",
    "test:emulator-paths": "node tests/test-emulator-paths.js",
    "test:help-doc-resolver": "node tests/test-help-doc-resolver.js",
    "test:python-compat": "node tests/test_python_script_compat.js",
    "test:updategames": "node tests/test_updategames.js",
    "test:usb2snes-list": "node tests/test_usb2snes_list.js",
    "test:usb2snes-mkdir": "node tests/test_usb2snes_mkdir.js",
    "test:usb2snes-putfile": "node tests/test_usb2snes_putfile.js",
    "test:usb2snes-full": "node tests/test_usb2snes_mkdir_then_upload.js",
    "test:migrations": "./enode.sh tests/test_migrations.js",
    "test:ci": "npm-run-all -s test:migrations",
    "utils:identify-keys": "node identify-incompatible-keys.js",
    "utils:reprocess-attachments": "node reprocess-attachments.js",
    "utils:backfill-rhmd": "node backfill_rhmd.js",
    "verify:blobs": "node verify-all-blobs.js --verify-blobs=files",
    "verify:blobs-db": "node verify-all-blobs.js --verify-blobs=db",
    "verify:blobs-full": "node verify-all-blobs.js --verify-blobs=files --full-check",
    "verify:blobs-db-full": "node verify-all-blobs.js --verify-blobs=db --full-check",
    "verify:blobs-result": "node verify-all-blobs.js --verify-blobs=files --full-check --verify-result",
    "verify:blobs-db-result": "node verify-all-blobs.js --verify-blobs=db --full-check --verify-result",
    "upload:list-ipfs": "node list-unuploaded-blobs.js --provider=ipfs",
    "upload:list-arweave": "node list-unuploaded-blobs.js --provider=arweave",
    "upload:list-ardrive": "node list-unuploaded-blobs.js --provider=ardrive"
  },
